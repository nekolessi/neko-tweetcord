# Discord Bot Token from Discord Developer Portal
BOT_TOKEN=your_discord_bot_token_here

# Twitter auth_token from cookies: "AccountAlias:AuthTokenHex"
# Multiple accounts can be separated with commas, e.g. "Account1:token1,Account2:token2"
TWITTER_TOKEN=MainAccount:your_twitter_auth_token_here

# Directory where tracked accounts database will be stored
DATA_PATH=./data
